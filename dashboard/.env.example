# ============================================================================
# LotoScope Dashboard - variaveis de ambiente
# Copie para .env.local e ajuste os valores. NAO comite .env.local.
# ============================================================================

# --- SQL Server -------------------------------------------------------------
# Use autenticacao SQL (usuario/senha) ou Windows (deixe DB_USER/DB_PASSWORD vazios).
DB_SERVER=localhost
DB_NAME=LOTOFACIL
DB_USER=sa
DB_PASSWORD=troque_esta_senha

# --- IA / Chat --------------------------------------------------------------
# Provedor padrao: openrouter | openai | google
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro

# --- Ollama (opcional, fallback local) --------------------------------------
# Se definido, o chat tenta http://localhost:11434/api/chat antes do OpenRouter.
OLLAMA_MODEL=
